    "icloud.status.noAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud on this iPhone (Settings > [your name]) to get notified when an agent needs you while Programa is in the background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Programaがバックグラウンドで実行されている間にエージェントが対応を必要とした際に通知を受け取るには、このiPhoneでiCloudにサインインしてください（設定 > [あなたの名前]）。"
          }
        }
      }
    },
    "icloud.status.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
